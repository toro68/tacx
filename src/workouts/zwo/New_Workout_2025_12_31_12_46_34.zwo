<workout_file>
    <author>-</author>
    <name>Day 4 - Tempo</name>
    <description>Tempo training: The goal of this training is to spend time in Zone 3 at an intensity where the use of sugar and fats as fuel is equal. Time spent in this zone increases muscle glycogen storages.</description>
    <sportType>bike</sportType>
    <tags>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.55"/>
        <IntervalsT Repeat="4" OnDuration="240" OffDuration="120" OnPower="0.88" OffPower="0.52"/>
        <SteadyState Duration="120" Power="0.52"/>
        <SteadyState Duration="180" Power="0.86"/>
        <SteadyState Duration="180" Power="0.89"/>
        <SteadyState Duration="180" Power="0.52"/>
        <SteadyState Duration="180" Power="0.89"/>
        <SteadyState Duration="180" Power="0.86"/>
        <SteadyState Duration="180" Power="0.52"/>
        <SteadyState Duration="180" Power="0.86"/>
        <SteadyState Duration="180" Power="0.89"/>
        <SteadyState Duration="180" Power="0.52"/>
        <IntervalsT Repeat="5" OnDuration="60" OffDuration="180" OnPower="1" OffPower="0.52"/>
        <Cooldown Duration="180" PowerLow="0.55" PowerHigh="0.5"/>
    </workout>
</workout_file>
